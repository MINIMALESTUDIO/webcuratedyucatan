# Variables de entorno de Curated Yucatán
# Copia este archivo a .env.local y completa los valores. Nunca subas .env* al repositorio.
# Solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador.

# --- Sitio -----------------------------------------------------------------
# URL pública sin "/" final. Se usa en metadatos y enlaces absolutos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" solo en producción con contenido real. Con "false", todas las páginas llevan
# noindex y robots.txt bloquea el sitio (ver D-028). Se lee en el build.
SITIO_INDEXABLE=false

# --- Sanity: sitio (Fase 2) -------------------------------------------------
# Sin NEXT_PUBLIC_SANITY_PROJECT_ID el sitio usa los datos DEMO locales (D-033).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# URL del Studio publicado: los clics de "Editar en la página" abren los campos ahí (D-034).
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Token de solo lectura (rol Viewer) para borradores y documentos privado.* (D-012).
# Solo en el servidor: nunca se comparte con el navegador.
SANITY_API_READ_TOKEN=
# Solo local, para cargar datos DEMO. Nunca en producción.
SANITY_API_WRITE_TOKEN=
# Secreto de la firma del webhook de revalidación (ver D-010).
SANITY_REVALIDATE_SECRET=

# --- Sanity: Studio (npm run studio / studio:deploy) -------------------------
# La CLI de Sanity solo lee variables con prefijo SANITY_STUDIO_.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Sitio que se abre en "Editar en la página": local o la URL de Hostinger.
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
# Subdominio del Studio publicado: https://<host>.sanity.studio
SANITY_STUDIO_HOST=curatedyucatan

# --- Base de datos MariaDB (Fase 0 y 4) --------------------------------------
# Usuario de la app: solo SELECT, INSERT y UPDATE.
DATABASE_URL=
# Usuario de migraciones; no se usa en tiempo de ejecución.
DATABASE_MIGRACIONES_URL=

# --- Correo (Fase 4) --------------------------------------------------------
RESEND_API_KEY=
CORREO_REMITENTE=
CORREO_EQUIPO=

# --- Anti-spam (Fase 4) -----------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Privacidad (Fase 4) ----------------------------------------------------
# Sal secreta para el hash de IP. Rotarla vuelve no vinculables los hashes anteriores.
IP_HASH_SALT=
